# Base de Datos (PostgreSQL)
# Ejemplo para Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Ejemplo para Railway: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/railway
DATABASE_URL="postgresql://usuario:password@localhost:5432/template_gestion"

# NextAuth
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-secret-key-aqui"
NEXTAUTH_URL="http://localhost:3000"

