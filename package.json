{
  "name": "template-gestion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "docker:dev": "docker-compose up -d",
    "docker:dev:build": "docker-compose up -d --build",
    "docker:dev:stop": "docker-compose down",
    "docker:dev:logs": "docker-compose logs -f app-dev",
    "docker:studio": "docker-compose --profile studio up -d prisma-studio",
    "docker:studio:stop": "docker-compose --profile studio down",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:build": "docker-compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:stop": "docker-compose -f docker-compose.prod.yml down",
    "docker:clean": "docker-compose down -v && docker-compose -f docker-compose.prod.yml down -v",
    "docker:restart": "docker-compose restart app-dev",
    "docker:shell": "docker exec -it template-gestion-app-dev sh"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "next": "^14.2.15",
    "@prisma/client": "^5.20.0",
    "next-auth": "^4.24.5",
    "zod": "^3.23.8",
    "react-hook-form": "^7.53.0",
    "@hookform/resolvers": "^3.9.0",
    "zustand": "^4.5.5",
    "lucide-react": "^0.446.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.3"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "prisma": "^5.20.0",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^3.4.14",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15"
  }
}
